+#[test]
+fn input_transport_follows_activation_flags() {
+    use ironrdp_core::decode;
+    use ironrdp_pdu::input::fast_path::{FastPathInput, FastPathInputEvent, KeyboardFlags, SynchronizeFlags};
+    use ironrdp_pdu::input::{InputEvent, MousePdu, MouseXPdu, mouse, mouse_x};
+    use ironrdp_pdu::mcs::SendDataRequest;
+    use ironrdp_pdu::rdp::capability_sets::InputFlags;
+    use ironrdp_pdu::rdp::headers::{ShareControlHeader, ShareControlPdu, ShareDataPdu};
+
+    let mut stage = ActiveStageBuilder {
+        input_flags: InputFlags::empty(),
+        static_channels: StaticChannelSet::new(),
+        user_channel_id: 1001,
+        io_channel_id: 1003,
+        message_channel_id: None,
+        share_id: 1,
+        compression_type: None,
+        enable_server_pointer: false,
+        pointer_software_rendering: false,
+    }
+    .build();
+    let mut image = DecodedImage::new(PixelFormat::RgbA32, 1, 1);
+    let events = [
+        FastPathInputEvent::KeyboardEvent(KeyboardFlags::empty(), 0x1e),
+        FastPathInputEvent::KeyboardEvent(
+            KeyboardFlags::RELEASE | KeyboardFlags::EXTENDED | KeyboardFlags::EXTENDED1,
+            0x1d,
+        ),
+        FastPathInputEvent::UnicodeKeyboardEvent(KeyboardFlags::RELEASE, 0x20ac),
+        FastPathInputEvent::MouseEvent(MousePdu {
+            flags: mouse::PointerFlags::MOVE,
+            number_of_wheel_rotation_units: 0,
+            x_position: 42,
+            y_position: 24,
+        }),
+        FastPathInputEvent::MouseEventEx(MouseXPdu {
+            flags: mouse_x::PointerXFlags::empty(),
+            x_position: 12,
+            y_position: 34,
+        }),
+        FastPathInputEvent::SyncEvent(SynchronizeFlags::CAPS_LOCK | SynchronizeFlags::NUM_LOCK),
+    ];
+    // Switch both ways to cover capability changes during reactivation, including INPUT2 alone.
+    for flags in [
+        InputFlags::empty(),
+        InputFlags::FASTPATH_INPUT,
+        InputFlags::FASTPATH_INPUT_2,
+        InputFlags::SCANCODES,
+    ] {
+        stage.set_input_flags(flags);
+        let output = stage.process_fastpath_input(&mut image, &events).unwrap();
+        let [ActiveStageOutput::ResponseFrame(frame)] = output.as_slice() else {
+            panic!("expected one input frame")
+        };
+        if flags.intersects(InputFlags::FASTPATH_INPUT | InputFlags::FASTPATH_INPUT_2) {
+            let pdu: FastPathInput = decode(frame).unwrap();
+            assert_eq!(pdu.input_events(), events);
+        } else {
+            let request: X224<SendDataRequest<'_>> = decode(frame).unwrap();
+            assert_eq!(request.0.initiator_id, 1001);
+            assert_eq!(request.0.channel_id, 1003);
+            let header: ShareControlHeader = decode(&request.0.user_data).unwrap();
+            assert_eq!(header.share_id, 1);
+            let ShareControlPdu::Data(data) = header.share_control_pdu else {
+                panic!("expected share data")
+            };
+            let ShareDataPdu::Input(input) = data.share_data_pdu else {
+                panic!("expected input")
+            };
+            assert_eq!(input.0.len(), events.len());
+            assert!(matches!(&input.0[0], InputEvent::ScanCode(pdu) if pdu.flags.bits() == 0 && pdu.key_code == 0x1e));
+            assert!(
+                matches!(&input.0[1], InputEvent::ScanCode(pdu) if pdu.flags.bits() == 0x8300 && pdu.key_code == 0x1d)
+            );
+            assert!(
+                matches!(&input.0[2], InputEvent::Unicode(pdu) if pdu.flags.bits() == 0x8000 && pdu.unicode_code == 0x20ac)
+            );
+            assert!(matches!(&input.0[3], InputEvent::Mouse(pdu) if pdu.x_position == 42 && pdu.y_position == 24));
+            assert!(matches!(&input.0[4], InputEvent::MouseX(pdu) if pdu.x_position == 12 && pdu.y_position == 34));
+            assert!(matches!(&input.0[5], InputEvent::Sync(pdu) if pdu.flags.bits() == 6));
+        }
+    }
+    stage.set_input_flags(InputFlags::empty());
+    assert!(stage.process_fastpath_input(&mut image, &[]).unwrap().is_empty());
+    assert!(
+        stage
+            .process_fastpath_input(&mut image, &[FastPathInputEvent::QoeEvent(123)])
+            .unwrap()
+            .is_empty()
+    );
+    let output = stage.process_fastpath_input(&mut image, &vec![events[0]; 256]).unwrap();
+    assert_eq!(output.len(), 2);
+}
