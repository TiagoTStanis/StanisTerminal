+#[test]
+fn bitmap_updates_clip_destination_and_source_height_without_flipping_visible_rows() {
+    // Normal destination, bottom/right clipping, extra source height, and both.
+    for (right, bottom, height) in [(2, 2, 2), (3, 3, 3), (2, 2, 4), (3, 3, 4)] {
+        for (bits_per_pixel, compressed) in [(24, false), (32, false), (24, true)] {
+            let mut pixels = Vec::new();
+            for y in (0..height).rev() {
+                for x in 0..3u8 {
+                    pixels.extend_from_slice(&[x, y, 10 + y * 3 + x]);
+                    if bits_per_pixel == 32 {
+                        pixels.push(255);
+                    }
+                }
+                if bits_per_pixel == 24 && !compressed {
+                    // Three pixels occupy nine bytes, padded to twelve on the wire.
+                    pixels.extend_from_slice(&[0; 3]);
+                }
+            }
+            if compressed {
+                // Interleaved RLE REGULAR_COLOR_IMAGE: literal bottom-up pixels.
+                pixels.insert(0, 0x80 | (3 * height));
+            }
+            let mut image = DecodedImage::new(PixelFormat::RgbA32, 3, 3);
+            let updates = processor()
+                .process_bitmap_update(
+                    &mut image,
+                    BitmapUpdateData {
+                        rectangles: vec![BitmapData {
+                            rectangle: InclusiveRectangle {
+                                left: 1,
+                                top: 1,
+                                right,
+                                bottom,
+                            },
+                            width: 3,
+                            height: u16::from(height),
+                            bits_per_pixel,
+                            compression_flags: if compressed {
+                                Compression::BITMAP_COMPRESSION
+                            } else {
+                                Compression::empty()
+                            },
+                            compressed_data_header: None,
+                            bitmap_data: &pixels,
+                        }],
+                    },
+                )
+                .expect("apply clipped bitmap");
+            assert!(matches!(
+                updates.as_slice(),
+                [ironrdp_session::fast_path::UpdateKind::Region(InclusiveRectangle {
+                    left: 1,
+                    top: 1,
+                    right: 2,
+                    bottom: 2,
+                })]
+            ));
+            let mut expected = vec![0; 3 * 3 * 4];
+            expected[16..24].copy_from_slice(&[10, 0, 0, 255, 11, 0, 1, 255]);
+            expected[28..36].copy_from_slice(&[13, 1, 0, 255, 14, 1, 1, 255]);
+            assert_eq!(
+                image.data(),
+                expected,
+                "destination ({right}, {bottom}), height {height}, depth {bits_per_pixel}, compressed {compressed}"
+            );
+        }
+    }
+}
