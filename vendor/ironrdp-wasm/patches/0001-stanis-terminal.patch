@@ -0,0 +1,266 @@
+//! Server Redirection PDU ([MS-RDPBCGR] 2.2.13), sent by an RD Connection Broker in place of the
+//! Server Demand Active PDU to send the client to the session host that should serve it.
+//!
+//! The connector does not reconnect by itself: it stops with a [`ConnectorError`] whose source is a
+//! [`ServerRedirection`], and the caller opens a new connection following the same rules as FreeRDP
+//! (`rdp_client_redirect` / `rdp_redirection_apply_settings`).
+
+use core::fmt;
+
+
+pub const LB_TARGET_NET_ADDRESS: u32 = 0x0000_0001;
+pub const LB_LOAD_BALANCE_INFO: u32 = 0x0000_0002;
+pub const LB_USERNAME: u32 = 0x0000_0004;
+pub const LB_DOMAIN: u32 = 0x0000_0008;
+pub const LB_PASSWORD: u32 = 0x0000_0010;
+pub const LB_NOREDIRECT: u32 = 0x0000_0080;
+pub const LB_TARGET_FQDN: u32 = 0x0000_0100;
+pub const LB_TARGET_NETBIOS_NAME: u32 = 0x0000_0200;
+pub const LB_TARGET_NET_ADDRESSES: u32 = 0x0000_0800;
+pub const LB_CLIENT_TSV_URL: u32 = 0x0000_1000;
+pub const LB_REDIRECTION_GUID: u32 = 0x0000_8000;
+pub const LB_TARGET_CERTIFICATE: u32 = 0x0001_0000;
+
+/// Share Control PDU type of the (Enhanced Security) Server Redirection PDU.
+const PDUTYPE_SERVER_REDIR_PKT: u16 = 0x000A;
+
+/// Parsed RDP_SERVER_REDIRECTION_PACKET.
+#[derive(Clone, PartialEq, Eq, Default)]
+pub struct ServerRedirection {
+    pub session_id: u32,
+    pub flags: u32,
+    pub target_net_address: Option<String>,
+    /// Routing token for the next X.224 Connection Request (e.g. `Cookie: msts=...`).
+    pub load_balance_info: Option<Vec<u8>>,
+    pub username: Option<String>,
+    pub domain: Option<String>,
+    pub target_fqdn: Option<String>,
+    pub target_netbios_name: Option<String>,
+    pub target_net_addresses: Vec<String>,
+}
+
+// Never print the routing token or anything credential-like in logs.
+impl fmt::Debug for ServerRedirection {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ServerRedirection")
+            .field("session_id", &self.session_id)
+            .field("flags", &format_args!("{:#x}", self.flags))
+            .field("has_target_net_address", &self.target_net_address.is_some())
+            .field("has_load_balance_info", &self.load_balance_info.is_some())
+            .field("has_target_fqdn", &self.target_fqdn.is_some())
+            .finish_non_exhaustive()
+    }
+}
+
+impl fmt::Display for ServerRedirection {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "server redirection (session {}, flags {:#x})", self.session_id, self.flags)
+    }
+}
+
+impl core::error::Error for ServerRedirection {}
+
+impl ServerRedirection {
+    /// Host the client should connect to next, following FreeRDP: with a new load-balancing token
+    /// the client goes back to the original address (`None`); otherwise FQDN, then IP, then NetBIOS.
+    ///
+    /// `prefer_address` ignores that rule and returns the explicit address anyway (used when a broker
+    /// that is not behind a load balancer redirects again to the same place).
+    pub fn target_host(&self, prefer_address: bool) -> Option<&str> {
+        if self.load_balance_info.is_some() && !prefer_address {
+            return None;
+        }
+        self.target_fqdn
+            .as_deref()
+            .or(self.target_net_address.as_deref())
+            .or_else(|| self.target_net_addresses.first().map(String::as_str))
+            .or(self.target_netbios_name.as_deref())
+            .filter(|host: &&str| !host.is_empty())
+    }
+
+    /// Routing token as printable ASCII without the trailing CRLF, if it is representable.
+    pub fn routing_token(&self) -> Option<String> {
+        let bytes = self.load_balance_info.as_deref()?;
+        let bytes = bytes.strip_suffix(b"\r\n").unwrap_or(bytes);
+        let bytes = bytes.strip_suffix(b"\0").unwrap_or(bytes);
+        (!bytes.is_empty() && bytes.iter().all(|b| (0x20..=0x7E).contains(b)))
+            .then(|| String::from_utf8_lossy(bytes).into_owned())
+    }
+}
+
+/// Parses a Server Redirection PDU from the MCS user data of a Send Data Indication, if that is what
+/// it is. Returns `None` for any other Share Control PDU (or malformed data), so callers fall back to
+/// their normal decoding.
+pub fn parse_server_redirection(user_data: &[u8]) -> Option<ServerRedirection> {
+    let mut r = Reader(user_data);
+    let _total_length = r.u16()?;
+    let pdu_type = r.u16()?;
+    if pdu_type & 0x000F != PDUTYPE_SERVER_REDIR_PKT {
+        return None;
+    }
+    let _pdu_source = r.u16()?;
+    r.skip(2)?; // pad2Octets
+
+    let _flags = r.u16()?; // SEC_REDIRECTION_PKT
+    let _length = r.u16()?;
+    let session_id = r.u32()?;
+    let flags = r.u32()?;
+    let mut redirection = ServerRedirection {
+        session_id,
+        flags,
+        ..ServerRedirection::default()
+    };
+
+    if flags & LB_TARGET_NET_ADDRESS != 0 {
+        redirection.target_net_address = Some(r.unicode()?);
+    }
+    if flags & LB_LOAD_BALANCE_INFO != 0 {
+        redirection.load_balance_info = Some(r.blob()?.to_vec());
+    }
+    if flags & LB_USERNAME != 0 {
+        redirection.username = Some(r.unicode()?);
+    }
+    if flags & LB_DOMAIN != 0 {
+        redirection.domain = Some(r.unicode()?);
+    }
+    if flags & LB_PASSWORD != 0 {
+        r.blob()?; // redirection password cookie: not used (NLA re-authenticates with the user credentials)
+    }
+    if flags & LB_TARGET_FQDN != 0 {
+        redirection.target_fqdn = Some(r.unicode()?);
+    }
+    if flags & LB_TARGET_NETBIOS_NAME != 0 {
+        redirection.target_netbios_name = Some(r.unicode()?);
+    }
+    if flags & LB_CLIENT_TSV_URL != 0 {
+        r.blob()?;
+    }
+    if flags & LB_REDIRECTION_GUID != 0 {
+        r.blob()?;
+    }
+    if flags & LB_TARGET_CERTIFICATE != 0 {
+        r.blob()?;
+    }
+    if flags & LB_TARGET_NET_ADDRESSES != 0 {
+        let _length = r.u32()?;
+        let count = r.u32()?;
+        for _ in 0..count.min(32) {
+            redirection.target_net_addresses.push(r.unicode()?);
+        }
+    }
+    Some(redirection)
+}
+
+struct Reader<'a>(&'a [u8]);
+
+impl<'a> Reader<'a> {
+    fn take(&mut self, n: usize) -> Option<&'a [u8]> {
+        if self.0.len() < n {
+            return None;
+        }
+        let (head, tail) = self.0.split_at(n);
+        self.0 = tail;
+        Some(head)
+    }
+
+    fn skip(&mut self, n: usize) -> Option<()> {
+        self.take(n).map(|_| ())
+    }
+
+    fn u16(&mut self) -> Option<u16> {
+        self.take(2).map(|b| u16::from_le_bytes([b[0], b[1]]))
+    }
+
+    fn u32(&mut self) -> Option<u32> {
+        self.take(4).map(|b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+    }
+
+    fn blob(&mut self) -> Option<&'a [u8]> {
+        let length = usize::try_from(self.u32()?).ok()?;
+        if length > 64 * 1024 {
+            return None;
+        }
+        self.take(length)
+    }
+
+    /// Length-prefixed UTF-16LE string, usually null-terminated.
+    fn unicode(&mut self) -> Option<String> {
+        let bytes = self.blob()?;
+        let units: Vec<u16> = bytes.chunks_exact(2).map(|c| u16::from_le_bytes([c[0], c[1]])).collect();
+        let end = units.iter().position(|&u| u == 0).unwrap_or(units.len());
+        String::from_utf16(&units[..end]).ok()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn unicode(s: &str) -> Vec<u8> {
+        let mut out: Vec<u8> = s.encode_utf16().chain([0]).flat_map(u16::to_le_bytes).collect();
+        let mut framed = u32::try_from(out.len()).unwrap().to_le_bytes().to_vec();
+        framed.append(&mut out);
+        framed
+    }
+
+    fn packet(flags: u32, fields: &[Vec<u8>]) -> Vec<u8> {
+        let body: Vec<u8> = fields.concat();
+        let mut pdu = Vec::new();
+        pdu.extend_from_slice(&0u16.to_le_bytes()); // totalLength (not checked)
+        pdu.extend_from_slice(&(0x10u16 | PDUTYPE_SERVER_REDIR_PKT).to_le_bytes());
+        pdu.extend_from_slice(&1002u16.to_le_bytes());
+        pdu.extend_from_slice(&[0, 0]);
+        pdu.extend_from_slice(&0x0400u16.to_le_bytes());
+        pdu.extend_from_slice(&0u16.to_le_bytes());
+        pdu.extend_from_slice(&7u32.to_le_bytes());
+        pdu.extend_from_slice(&flags.to_le_bytes());
+        pdu.extend_from_slice(&body);
+        pdu
+    }
+
+    #[test]
+    fn token_redirection_goes_back_to_the_original_address() {
+        let token = b"Cookie: msts=3640205228.15629.0000\r\n".to_vec();
+        let mut lb = u32::try_from(token.len()).unwrap().to_le_bytes().to_vec();
+        lb.extend_from_slice(&token);
+        let pdu = packet(
+            LB_TARGET_NET_ADDRESS | LB_LOAD_BALANCE_INFO | LB_USERNAME | LB_DOMAIN | LB_TARGET_FQDN,
+            &[unicode("10.0.0.20"), lb, unicode("usuario"), unicode("EMPRESA"), unicode("rdsh01.empresa.local")],
+        );
+        let r = parse_server_redirection(&pdu).expect("redirection");
+        assert_eq!(r.session_id, 7);
+        assert_eq!(r.target_net_address.as_deref(), Some("10.0.0.20"));
+        assert_eq!(r.username.as_deref(), Some("usuario"));
+        assert_eq!(r.domain.as_deref(), Some("EMPRESA"));
+        assert_eq!(r.target_fqdn.as_deref(), Some("rdsh01.empresa.local"));
+        assert_eq!(r.routing_token().as_deref(), Some("Cookie: msts=3640205228.15629.0000"));
+        assert_eq!(r.target_host(false), None);
+        assert_eq!(r.target_host(true), Some("rdsh01.empresa.local"));
+    }
+
+    #[test]
+    fn address_redirection_prefers_fqdn_then_ip() {
+        let pdu = packet(LB_TARGET_NET_ADDRESS | LB_TARGET_FQDN, &[unicode("10.0.0.20"), unicode("rdsh01.empresa.local")]);
+        assert_eq!(parse_server_redirection(&pdu).unwrap().target_host(false), Some("rdsh01.empresa.local"));
+        let pdu = packet(LB_TARGET_NET_ADDRESS, &[unicode("10.0.0.21")]);
+        assert_eq!(parse_server_redirection(&pdu).unwrap().target_host(false), Some("10.0.0.21"));
+    }
+
+    #[test]
+    fn ten_byte_rtt_request_is_auto_detect_not_multitransport() {
+        // Basic security header (flags = SEC_AUTODETECT_REQ, flagsHi = 0) + RTT Measure Request
+        // (headerLength 6, headerTypeId 0, sequenceNumber 1, requestType 0x1001): the 10-byte PDU a
+        // Windows server sent on the message channel after licensing.
+        let pdu = [0x00, 0x10, 0x00, 0x00, 0x06, 0x00, 0x01, 0x00, 0x01, 0x10];
+        assert!(ironrdp_core::decode::<ironrdp_pdu::rdp::autodetect::AutoDetectReqPdu>(&pdu).is_ok());
+        assert!(ironrdp_core::decode::<ironrdp_pdu::rdp::multitransport::MultitransportRequestPdu>(&pdu).is_err());
+    }
+
+    #[test]
+    fn other_share_control_pdus_are_not_redirections() {
+        let mut demand_active = packet(0, &[]);
+        demand_active[2] = 0x11; // DemandActivePdu
+        assert!(parse_server_redirection(&demand_active).is_none());
+        assert!(parse_server_redirection(&[1, 2, 3]).is_none());
+    }
+}
